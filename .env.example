# Copia este archivo como .env y ajusta los valores.
# Secreto para firmar los JWT (obligatorio en producción).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Vigencia del token: 15m, 12h, 7d...
JWT_EXPIRES_IN=7d
# Puerto publicado en el host
PORT=3000
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
